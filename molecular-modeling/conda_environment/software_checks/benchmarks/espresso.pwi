&CONTROL
   calculation      = 'scf'
   restart_mode     = 'from_scratch'
   tstress          = .true.
   tprnfor          = .true.
   outdir           = './qe_tmp/'
   prefix           = 'qe_test'
   pseudo_dir       = '/home/rehim/Desktop/Molecular-and-Materials-Modeling-2026-August/molecular-modeling/conda_environment/software_checks/benchmarks'
/
&SYSTEM
   ecutwfc          = 30.0
   ecutrho          = 120.0
   occupations      = 'smearing'
   degauss          = 0.02
   smearing         = 'gaussian'
   ntyp             = 2
   nat              = 24
   ibrav            = 0
/
&ELECTRONS
   conv_thr         = 1e-06
   mixing_beta      = 0.7
   diagonalization  = 'david'
/
&IONS
/
&CELL
/
&FCP
/
&RISM
/
ATOMIC_SPECIES
O 15.999 O.upf
H 1.008 H.upf

K_POINTS automatic
1 1 1  0 0 0

