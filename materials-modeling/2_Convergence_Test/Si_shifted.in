&CONTROL
   calculation      = 'scf'
   pseudo_dir       = './'
   outdir           = './tmp'
   tstress          = .true.
   tprnfor          = .true.
   verbosity        = 'high'
/
&SYSTEM
   ibrav            = 0
   nat              = 2
   ntyp             = 1
   ecutwfc          = 70
   ecutrho          = 700
   occupations      = 'smearing'
   smearing         = 'gaussian'
   degauss          = 0.01
/
&ELECTRONS
   conv_thr         = 1e-10
   mixing_beta      = 0.7
/

ATOMIC_SPECIES
Si 28.085 Si.upf

K_POINTS automatic
10 10 10  0 0 0

CELL_PARAMETERS angstrom
    0.0000000000     2.7149000000     2.7149000000
    2.7149000000     0.0000000000     2.7149000000
    2.7149000000     2.7149000000     0.0000000000

ATOMIC_POSITIONS angstrom
Si       1.4574500000     4.1723500000     4.1723500000
Si       0.1000000000     0.1000000000     0.1000000000
